# netprobe Konfiguration – Beispiel.
# Produktiv wird diese Datei nach /etc/netprobe/netprobe.env kopiert.
# KEINE echten Secrets in das Repository committen.

# Geheimschlüssel für Cookie-Signierung – zwingend zufällig setzen!
# Erzeugen z. B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NETPROBE_SECRET_KEY=change-me-please-generate-a-random-value

# Netzwerk / HTTP
NETPROBE_HOST=127.0.0.1
NETPROBE_PORT=8000
# true setzen, wenn nginx TLS terminiert (Secure-Cookies)
NETPROBE_HTTPS_ENABLED=false

# Pfade
NETPROBE_DATA_DIR=/var/lib/netprobe
NETPROBE_CAPTURE_DIR=/var/lib/netprobe/captures
NETPROBE_LOG_DIR=/var/log/netprobe
NETPROBE_FRONTEND_DIST=/opt/netprobe/frontend/dist

# Datenbank
NETPROBE_DATABASE_URL=sqlite:////var/lib/netprobe/db.sqlite

# Externe Tools (Pfad oder Name im PATH)
NETPROBE_SPEEDTEST_BIN=speedtest
NETPROBE_FPING_BIN=fping
NETPROBE_PING_BIN=ping
NETPROBE_DUMPCAP_BIN=dumpcap
NETPROBE_TSHARK_BIN=tshark

# Speedtest-Planung
NETPROBE_SPEEDTEST_ENABLED=true
NETPROBE_SPEEDTEST_INTERVAL_MIN=60
# Fester Server (leer lassen für Auto-Selection)
# NETPROBE_SPEEDTEST_SERVER_ID=12345

# Capture-Limits
NETPROBE_CAPTURE_DEFAULT_DURATION_S=60
NETPROBE_CAPTURE_MAX_DURATION_S=900
NETPROBE_CAPTURE_DEFAULT_SIZE_MB=100
NETPROBE_CAPTURE_MAX_SIZE_MB=500
NETPROBE_CAPTURE_RETENTION_DAYS=14

# Retention
NETPROBE_PING_RAW_RETENTION_DAYS=14
NETPROBE_PING_AGG_RETENTION_DAYS=365
NETPROBE_RESULT_RETENTION_DAYS=365

# Analyse-Limits
NETPROBE_TSHARK_TIMEOUT_S=120
NETPROBE_DISPLAY_FILTER_MAX_PACKETS=1000

# Login / Sessions
NETPROBE_LOGIN_RATE_MAX_ATTEMPTS=5
NETPROBE_LOGIN_RATE_WINDOW_S=300
NETPROBE_SESSION_MAX_AGE_S=43200

# Erst-Admin (nur beim allerersten Start ausgewertet; danach entfernen)
# NETPROBE_ADMIN_USER=admin
# NETPROBE_ADMIN_PASSWORD=bitte-sicheres-passwort-setzen
